# Edutou API -- environment configuration.
#
# Local:   cp .env.example .env  and fill in the blanks
# Dokploy: paste these keys into the backend application's Environment tab.

NODE_ENV=production
PORT=4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Dokploy's Postgres service exposes an internal hostname -- use that, not a
# public address, so traffic never leaves the server.
#   postgres://USER:PASSWORD@edutou-db:5432/edutou
DATABASE_URL=
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Required, minimum 32 characters. The process refuses to start without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 15 minutes. Short by design: the role is re-read from the database on every
# request, so a demoted user loses access almost immediately.
ACCESS_TOKEN_TTL_SECONDS=900
# 30 days. Rotated on every use; the previous token is revoked as it is issued.
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Browser origins allowed to call this API with credentials. Comma-separated.
# A wildcard is not valid here -- credentialed CORS forbids it.
CORS_ORIGINS=https://edutou.example.com

# This API's own public origin. Used for OAuth redirect URIs and file URLs.
PUBLIC_URL=https://api.edutou.example.com

# Where to send the browser after OAuth completes.
FRONTEND_URL=https://edutou.example.com

# Needed only when the frontend and API are on different subdomains of one
# parent domain, so the session cookie is shared. Leave blank otherwise.
COOKIE_DOMAIN=.edutou.example.com

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Must be a mounted volume in Dokploy, or every upload is lost on redeploy.
STORAGE_DIR=/var/lib/edutou/uploads
# 25 MiB
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------------
# Google sign-in (optional -- omit both to hide the button)
# ---------------------------------------------------------------------------
# Authorized redirect URI in Google Cloud Console must be exactly:
#   <PUBLIC_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
