# =============================================================================
# Edutou API -- environment configuration
# =============================================================================
#
# DOKPLOY:  copy the "PASTE INTO DOKPLOY" block below into the application's
#           Environment tab, then replace the CAPITALISED placeholders.
# LOCAL:    cp .env.example .env  and use the localhost values in the comments.
#
# Only DATABASE_URL and JWT_SECRET have no default -- the process exits at boot
# if either is missing or malformed, rather than starting in a broken state.
# Everything else has a default, but the defaults are localhost values, so the
# URL group MUST be set in production.
# =============================================================================


# ----------------------------------------------------------------------------
# ---------------------- PASTE INTO DOKPLOY FROM HERE ------------------------
# ----------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# --- Database ---------------------------------------------------------------
# REQUIRED. The host is the Dokploy PostgreSQL service NAME, not an IP and not
# a public address -- containers reach each other on the internal network.
# If you named the database service something other than `edutou-db`, change it
# here to match exactly.
#   local: postgres://edutou:devpw@localhost:5432/edutou
DATABASE_URL=postgres://edutou:YOUR_DB_PASSWORD@edutou-db:5432/edutou
DATABASE_POOL_MAX=10

# --- Auth -------------------------------------------------------------------
# REQUIRED. Minimum 32 characters. Signs every access token, so rotating it
# signs everybody out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=YOUR_GENERATED_JWT_SECRET

# 15 minutes. Short on purpose: the user's role is re-read from the database on
# every request, so a demoted account loses access almost immediately.
ACCESS_TOKEN_TTL_SECONDS=900
# 30 days. Rotated on each use; the previous token is revoked as it is issued.
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- URLs -------------------------------------------------------------------
# Replace edutou.example.com with your real domain in all four values.

# Browser origins allowed to call this API with cookies. Comma-separated.
# Must include the scheme. No trailing slash. This is the FRONTEND origin,
# not this API's. A wildcard is invalid here -- credentialed CORS forbids it.
#   local: http://localhost:3000
CORS_ORIGINS=https://edutou.example.com

# This API's own public origin. Used to build file URLs and the Google OAuth
# redirect URI.
#   local: http://localhost:4000
PUBLIC_URL=https://api.edutou.example.com

# Where the browser is sent after OAuth completes.
#   local: http://localhost:3000
FRONTEND_URL=https://edutou.example.com

# The PARENT domain shared by the frontend and this API, with a leading dot.
# Required whenever they sit on different subdomains, or the browser will not
# send the session cookie to the API -- login appears to succeed and then
# bounces straight back to /login.
#   frontend edutou.example.com + api api.edutou.example.com -> .edutou.example.com
# Leave BLANK if both are served from one hostname, or when running locally.
# "Blank" means blank -- do NOT write the word "none" here. It would be sent to
# the browser as Domain=none, which matches no host, so the browser discards
# the session cookie and every request arrives unauthenticated.
COOKIE_DOMAIN=.edutou.example.com

# lax | strict | none. Leave at "lax" while every frontend shares this API's
# registrable domain (portal.edutou.in and api.edutou.in both end in edutou.in).
#
# Set to "none" ONLY to support a frontend on a different registrable domain,
# e.g. portal.qbitio.com calling api.edutou.in. That makes the session a
# third-party cookie: Safari and every browser on iOS block those outright and
# Chrome blocks them in Incognito, so those users cannot sign in at all.
# Requires HTTPS. Giving this API a hostname on the frontend's own domain is
# the alternative that works everywhere.
COOKIE_SAMESITE=lax

# --- Uploads ----------------------------------------------------------------
# Where uploaded bytes are kept: "s3" or "disk".
#
# RECOMMENDED FOR PRODUCTION: s3. Object storage outlives the container by
# construction, so a redeploy cannot take student submissions with it.
#
# Leave STORAGE_DRIVER unset and it is inferred: s3 when S3_ENDPOINT is set,
# disk otherwise. Naming an endpoint is therefore enough to switch.
STORAGE_DRIVER=s3

# --- Object storage (STORAGE_DRIVER=s3) -------------------------------------
# Garage, MinIO, R2 or AWS. On Dokploy use the Garage service's INTERNAL
# address -- the API talks to it over the private network, and the store never
# needs to face the internet: downloads are streamed through this API so the
# access checks and signed URLs still apply.
#
# The bucket must already exist and the key must have read+write on it. With
# Garage:
#   garage bucket create edutou
#   garage key create edutou-api
#   garage bucket allow --read --write edutou --key edutou-api
S3_ENDPOINT=http://garage:3900
S3_BUCKET=edutou
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Whatever the store calls its region. Garage's default is "garage"; MinIO and
# R2 use "us-east-1"; AWS uses the real region name.
S3_REGION=garage
# Path-style addressing (endpoint/bucket/key). Required by Garage and MinIO
# unless wildcard DNS points at them. Leave true unless you know otherwise.
S3_FORCE_PATH_STYLE=true

# --- Local volume (STORAGE_DRIVER=disk) -------------------------------------
# Only durable if this path is a mounted volume (Dokploy: Advanced -> Volumes).
# WITHOUT that volume every task submission and shared resource is discarded on
# redeploy, and downloads then answer 404 for rows the portal still lists.
# Verify with: npm run storage:doctor
#   local: ./uploads
STORAGE_DIR=/var/lib/edutou/uploads

# 25 MiB. Raise it if students submit video.
MAX_UPLOAD_BYTES=26214400

# --- Google sign-in (OPTIONAL) ----------------------------------------------
# Leave both blank to disable -- the button hides itself.
# The authorized redirect URI in Google Cloud Console must be EXACTLY:
#   <PUBLIC_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# ------------------------- END OF DOKPLOY BLOCK -----------------------------
# ----------------------------------------------------------------------------


# =============================================================================
# Local development with docker-compose.yml only
# =============================================================================
# docker-compose.yml in this repo runs Postgres + this API together for local
# work. It is NOT what Dokploy deploys -- there the database is a separate
# managed service. These variables are read only by that compose file.
#
# POSTGRES_USER=edutou
# POSTGRES_DB=edutou
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# BACKEND_PORT=4000
